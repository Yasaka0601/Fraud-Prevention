<div class="home-page">
  <div class="home-container">

    <!-- お知らせブロック -->
    <div class="announcement-section">
      <h2 class="section-title">お知らせ</h2>

      <div class="announcement-card">
        <% if @announcements.present? %>
          <ul class="announcement-list">
            <% @announcements.each do |announcement| %>
              <li class="announcement-item">
                <div class="announcement-date">
                  <%= announcement.published_at&.strftime("%Y年%m月%d日") %>
                </div>

                <% if announcement.url.present? %>
                  <%= link_to announcement.url, class: "announcement-title announcement-link" do %>
                    <span><%= announcement.title %></span>
                    <%# リンクであることを示す控えめな矢印アイコン %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="announcement-arrow" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                <% else %>
                  <h3 class="announcement-title"><%= announcement.title %></h3>
                <% end %>

                <% if announcement.body.present? %>
                  <p class="announcement-body"><%= announcement.body %></p>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="announcement-empty">
            現在、新しいお知らせはありません。
          </div>
        <% end %>
      </div>
    </div>

    <!-- ステータスパネルエリア -->
    <div class="status-grid">

      <!-- 家族ルーム情報 -->
      <div class="status-card">
        <h3 class="status-label">所属中の家族ルーム</h3>

        <% if user_signed_in? %>
          <% if @room.present? %>
            <div class="status-room">
              <strong class="status-value"><%= @room.name %></strong>
            </div>
          <% else %>
            <div class="status-room">
              <strong class="status-value status-value--empty">現在家族ルームに属していません</strong>
            </div>
          <% end %>
        <% else %>
          <div class="status-room">
            <strong class="status-value status-value--empty">ログインすると<br>家族ルーム機能が使えます</strong>
          </div>
        <% end %>
      </div>

      <!-- ポイント情報 -->
      <div class="status-card status-card--point">
        <h3 class="status-label">今週の合計ポイント</h3>

        <% if user_signed_in? %>
          <div class="status-point">
            <strong class="status-value status-value--point"><%= current_user.total_point || 0 %></strong>
            <span class="status-point__unit">pt</span>
          </div>
        <% else %>
          <div class="status-point">
            <strong class="status-value status-value--empty">ログインすると<br>ポイント機能が使えます</strong>
          </div>
        <% end %>
      </div>
    </div>

    <!-- カテゴリー一覧 -->
    <!-- カテゴリーを追加すれば,ヘルパーに追記すること-->
    <div data-controller="home">
      <h2 class="section-title">本日の稽古（カテゴリー選択）</h2>

      <div class="category-grid" data-home-target="category_grid">
        <% @categories.each do |category| %>
          <%= link_to category_courses_path(category), class: "category-card" do %>
            <div class="category-icon-wrapper">
              <%= category_icon_svg(category) %>
            </div>
            <h3 class="category-title"><%= category.name %></h3>

            <p class="category-desc">
              <%= category_desc(category) %>
            </p>

            <div class="category-arrow">➜</div>
          <% end %>
        <% end %>
      </div>
    </div>

  </div>
</div>