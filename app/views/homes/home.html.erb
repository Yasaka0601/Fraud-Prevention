<h1>詐欺対策道場ホーム</h1>


<% if @room.present? %>
  <p>
  現在参加中の家族ルーム :
  <strong><%= @room.name %></strong>
  </P>
<% else %>
  <p>現在家族ルームに属していません</p>
<% end %>

<p>
  今週の合計ポイント：
  <strong><%= current_user.total_point %> pt</strong>
</p>

<% @categories.each do |category| %>
  <li>
    <%= link_to category.name, category_courses_path(category) %>
  </li>
<% end %>
