<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <%= show_meta_tags %>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/favicon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application",
                            "data-turbo-track": "reload",
                            preload_links_header: false %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV["GA_MEASUREMENT_ID"] %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= ENV["GA_MEASUREMENT_ID"] %>');
    </script>
  </head>

  <body>
    <%= render "shared/header" %>
    <%= render "shared/flash_message" %>
    <%= yield %>

    <!----- バッジ獲得通知 (Toast) ----->
    <% if flash[:new_badges].present? %>
      <div class="toast toast-top toast-end" data-controller="auto-dismiss" style="z-index: 9999; margin-top: 4rem;">
        <% flash[:new_badges].each do |badge_type| %>
          <div class="bg-white border-l-4 border-[#C63D2F] shadow-xl rounded-lg flex items-center gap-4 p-4 max-w-sm animate-fade-in">
            <div class="w-12 h-12 flex-shrink-0 drop-shadow-sm">
              <%= badge_icon(badge_type) %>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-bold text-[#C63D2F] mb-0.5">新しい勲章を獲得しました！</span>
              <span class="text-base font-bold text-[#1F2F54]">
                <%= UserBadge::BADGE_NAMES[badge_type.to_sym] %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render "shared/footer" %>
  </body>
</html>
