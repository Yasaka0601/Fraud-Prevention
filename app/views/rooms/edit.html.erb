<div class="room-container animate-fade-in">

  <div class="room-edit-card">
    <h1 class="room-edit-title">家族ルームの設定</h1>

    <!------- ルーム名編集フォーム ------>
    <%= form_with model: @room, local: true do |f| %>

      <div class="form-field">
        <%= f.label :name, "家族ルーム名", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", placeholder: "例：佐藤家の修行場" %>
      </div>

      <div class="form-actions text-center">
        <%= f.submit "変更を保存する", class: "form-submit" %>
      </div>

    <% end %>

    <!-------- 退室のエリア -------->
    <div class="room-danger-zone">

      <!------ アラートの表示 --------->
      <% if @show_warning %>
        <div class="room-alert-wrapper">
          <div role="alert" class="room-alert-box layout-stack">
            <div class="flex items-start gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 alert-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>

              <!---------- アラートの説明文 ---------->
              <div class="alert-content">
                <span class="alert-title">本当に退室しますか？</span>
                <span class="alert-desc">現在所属している家族ルームから抜けることになります。<br>再び参加するには、招待リンクが必要になります。</span>
              </div>
            </div>

            <!---------- 「いいえ」ボタン ---------->
            <div class="alert-actions">
              <%= link_to "いいえ", home_rooms_path, class: "btn btn-sm btn-ghost bg-white hover:bg-gray-100 border-gray-300" %>

              <!----------- 「はい」ボタン ---------->
              <%= button_to "はい、退室します",
                    room_path(@room, confirm: 1),
                    method: :delete,
                    class: "btn btn-sm btn-error text-white" %>
            </div>
          </div>
        </div>
      <% end %>

      <!----------  退室ボタン表示 ----------->
      <% unless @show_warning %>

        <%= button_to room_path(@room), method: :delete, class: "btn-room-leave" do %>
          <span>この家族ルームから退室する</span>
        <% end %>
      <% end %>

    </div>

  </div>

  <%# --- 戻るボタン --- %>
  <div class="text-center">
    <%= link_to home_rooms_path, class: "btn-back-to-categories" do %>
      家族ルームへ戻る
    <% end %>
  </div>

</div>