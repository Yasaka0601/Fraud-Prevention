<div class="form-page animate-fade-in">

  <div class="form-card">
    <h1 class="room-new-title">家族ルーム作成</h1>

    <!-- エラーメッセージ表示エリア -->
    <% if @room.errors.any? %>
      <div class="room-simple-error">
        <ul>
          <% @room.errors.full_messages.each do |message| %>
            <li><i class="fas fa-exclamation-circle mr-1"></i><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-----  フォーム ----->
    <%= form_with model: @room, local: true do |form| %>

      <div class="form-field">
        <%= form.label :name, "家族ルーム名", class: "form-label" %>
        <%= form.text_field :name,
              class: "form-input",
              autofocus: true %>
      </div>

      <div class="form-actions">
        <%= form.submit "作成する", class: "form-submit" %>
      </div>

    <% end %>

    <!----- 戻るリンク ----->

    <div class="courses-footer">
      <%= link_to home_path, class: "back-link" do %>
        <span>&larr; 戻る</span>
      <% end %>
    </div>

  </div>
</div>
