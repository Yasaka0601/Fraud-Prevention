<h1 class="ranking-title">ランキング</h1>

<div class="ranking-scope">
  <% scope = (@scope.presence || "room") %>

  <%= link_to "家族ルーム内",
      rankings_path(scope: "room"),
      class: "ranking-scope__link #{scope == "room" ? "is-active" : ""}" %>

  <%= link_to "全体",
      rankings_path(scope: "all"),
      class: "ranking-scope__link #{scope == "all" ? "is-active" : ""}" %>
</div>

<% if scope == "room" && current_user.room.blank? %>
  <p class="ranking-empty">家族ルームに属していません。</p>
<% else %>
  <% if @users.present? %>
    <ol class="ranking-list">
      <% @users.each do |user| %>
        <% is_tie = @tie_counts[user.total_point].to_i > 1 %>

        <li class="ranking-row">
          <span class="ranking-rank">
            <strong><%= "#{user.point_rank}位" %></strong>
          </span>

          <%= avatar_image_tag(user, css_class: "ranking-avatar") %>

          <span class="ranking-name"><%= user.name %></span>
          <span class="ranking-point">（<%= user.total_point %>pt）</span>
        </li>
      <% end %>
    </ol>

    <div class="ranking-pagination">
      <%= paginate @users %>
    </div>
  <% else %>
    <p class="ranking-empty">ランキング対象がいません。</p>
  <% end %>
<% end %>

<div class="ranking-back">
  <%= link_to "戻る", home_path, class: "ranking-back__link" %>
</div>