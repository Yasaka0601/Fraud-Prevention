<div class="quiz-container"
    data-controller="quiz-scroll"
    data-action="turbo:submit-end@document->quiz-scroll#scrollToResult">

  <!----- 進捗表示 ----->
  <div class="quiz-header">
    <h1 class="quiz-course-name"><%= @course.name %></h1>
    <div class="quiz-progress">
      <span>第 <%= @index %> 問</span>
      <!-----  進捗バー ------>
      <div class="quiz-progress-bar">
        <div class="quiz-progress-fill" style="width: <%= (@index.to_f / 5 * 100).to_i %>%;"></div>
      </div>
      <span>/ 5</span>
    </div>
  </div>

  <!------ 判定結果エリア ------->
  <div id="quiz_result_area" data-quiz-scroll-target="resultArea">
    <%= render "quizzes/result" %>
  </div>

  <!------ クイズカード ------->
  <div class="quiz-card">
    <h2 class="quiz-question-number">問 <%= @index %></h2>

    <p class="quiz-sentence"><%= @quiz.sentence %></p>

    <% if @quiz.image.attached? %>
      <div class="quiz-image-container">
        <%= image_tag @quiz.image, class: "quiz-image" %>
      </div>
    <% end %>

    <!------ 回答エリア ------->
    <div id="quiz_answer_area">
      <%= render "quizzes/answer" %>
    </div>
  </div>

</div>
