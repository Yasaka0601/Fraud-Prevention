<% total_questions = @total_questions.to_i %>
<% correct_count = @correct_count.to_i %>
<% incorrect_count = [total_questions - correct_count, 0].max %>

<div class="result-container animate-fade-in">
  <div class="score-card">
    <p class="point-label text-gray-500 mb-2"><%= @course.name %></p>

    <h1 class="result-course-title" style="font-size: 1.5rem;">
      稽古結果
    </h1>

    <div class="result-score-text">
      <span class="text-lg font-bold">正解数：</span>
      <span class="score-highlight"><%= correct_count %></span>
      <span class="text-lg"> / <%= total_questions %> 問</span>
    </div>

    <div class="share-summary-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 420px; margin-inline: auto;">
      <div class="share-stat-item">
        <span class="share-stat-label">正解</span>
        <span class="share-stat-value share-stat-value--correct"><%= correct_count %>問</span>
      </div>
      <div class="share-stat-item">
        <span class="share-stat-label">不正解</span>
        <span class="share-stat-value share-stat-value--incorrect"><%= incorrect_count %>問</span>
      </div>
    </div>
  </div>

  <div class="share-welcome-box">
    <h2 class="share-welcome-title">成績を保存するには新規登録が必要です</h2>
    <p class="share-welcome-text">
      新規登録すると、稽古の記録保存や成績履歴の確認ができます。<br>
      すでにアカウントをお持ちの場合はログインしてください。
    </p>

    <div class="top-actions">
      <%= link_to "新規登録する", new_user_registration_path, class: "top-btn top-btn--primary" %>
      <%= link_to "ログインする", new_user_session_path, class: "top-btn top-btn--outline" %>
    </div>
  </div>

  <div class="result-nav">
    <%= link_to home_path, class: "btn-back-to-categories" do %>
      カテゴリー選択へ戻る
    <% end %>
  </div>
</div>
