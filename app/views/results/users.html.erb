<h1>成績を見るユーザーを選択</h1>

<ul>
  <% if @room_users.present? %>
    <% @room_users.each do |user| %>
      <li>
        <%= link_to results_path(user_id: user.id), class: "user-link" do %>
          <%= avatar_image_tag(user) %>
          <%= "#{user.name} の成績" %>
        <% end %>
      </li>
    <% end %>
    <%= paginate @room_users %>
  <% else %>
    <li>
      <%= link_to results_path(user_id: current_user.id), class: "user-link " do %>
        <%= avatar_image_tag(current_user) %>
        <%= "#{current_user.name} の成績" %>
      <% end %>
    </li>

    <p>家族ルームに参加すれば、同じルーム内の人の成績を閲覧することができます。</p>
  <% end %>
</ul>

<%= link_to "ホームへ", home_path %>