<div class="result-container result-container--show animate-fade-in">

  <!----- 総合スコアカード ----->

  <div class="score-card">
    <h1 class="result-course-title">
      <%= @target_user.name %>の成績
      <%= @course_result.course.name %>
    </h1>

    <div class="score-summary">
      <div class="result-score-text">
        正解数：
        <span class="score-highlight"><%= @course_result.correct_count %></span>
        <span class="text-lg"> / <%= @course_result.total_questions %> 問</span>
      </div>

      <!----- 獲得ポイント ------>
      <div class="result-point-badge">
        <span class="point-label">獲得</span>
        <div class="point-value"><%= @get_point %></div>
        <span class="point-unit">pt</span>
      </div>
    </div>

    <!----- X シェアボタン (デザイン適用) ----->
    <% if @course_result.user_id == current_user.id %>
      <% tweet_text = "「#{@course_result.course.category.name}」「#{@course_result.course.name}」コース\n#{@course_result.total_questions}問中、#{@course_result.correct_count}問正解。" %>
      <% intent_url = "https://twitter.com/intent/tweet?text=#{CGI.escape(tweet_text)}&url=#{CGI.escape(@share_url)}&hashtags=詐欺対策道場" %>

      <div class="share-area">
        <%= link_to intent_url, target: "_blank", rel: "noopener noreferrer", class: "btn-share-x" do %>
          <%# X (Twitter) ロゴSVG %>
          <svg class="icon-x-logo" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
          <span>結果をポストする</span>
        <% end %>
      </div>
    <% end %>

  </div>

  <!----- 各問題の振り返りリスト ----->
  <% @quiz_histories.each_with_index do |history, i| %>
    <% quiz = history.quiz %>
    <% correct_choices  = quiz.choices.select(&:is_correct) %>
    <% selected_choices = history.choices.to_a %>

    <!----- 正誤に応じてクラスを切り替え ------->
    <section class="history-card <%= history.correct? ? 'history-card--correct' : 'history-card--incorrect' %>">

      <!----- 問題番号と判定バッジ ------->
      <div class="history-q-number">
        <span>第 <%= i + 1 %> 問</span>
        <% if history.correct? %>
          <span class="status-badge status-badge--correct">正解</span>
        <% else %>
          <span class="status-badge status-badge--incorrect">不正解</span>
        <% end %>
      </div>

      <!----- 問題文 ------->
      <p class="history-sentence"><%= quiz.sentence %></p>

      <!------- 回答比較ブロック ------->
      <div class="answer-comparison">

        <!------  あなたの回答  ------->
        <div class="answer-block">
          <span class="answer-label">あなたの回答</span>
          <div class="font-bold text-gray-800">
            <% if selected_choices.present? %>
              <ul class="list-disc list-inside">
                <% selected_choices.each do |choice| %>
                  <li><%= choice.text %></li>
                <% end %>
              </ul>
            <% else %>
              <span class="text-gray-400">（無回答）</span>
            <% end %>
          </div>
        </div>

        <!------ 正解  -------->
        <div class="answer-block">
          <span class="answer-label text-[#C63D2F]">正解</span>
          <div class="font-bold text-[#C63D2F]">
            <ul class="list-disc list-inside">
              <% correct_choices.each do |choice| %>
                <li><%= choice.text %></li>
              <% end %>
            </ul>
          </div>
        </div>

      </div>

      <!------   解説  ------>
      <% if quiz.explanation.present? %>
        <div class="history-explanation">
          <span class="explanation-label">【解説】</span>
          <p class="history-explanation-text"><%= auto_link(quiz.explanation, sanitize: true, html: { target: "_blank", rel: "noopener noreferrer nofollow" }) %></p>
        </div>
      <% end %>

    </section>
  <% end %>

  <!------- ナビゲーションボタン --------->
  <div class="result-nav">
    <%= link_to results_path, class: "nav-btn nav-btn--primary" do %>
      成績一覧へ
    <% end %>

    <%= link_to home_path, class: "btn-back-to-categories" do %>
      カテゴリー選択へ戻る
    <% end %>
  </div>

</div>
