<div class="invitation-container animate-fade-in">
  <div class="invitation-card">

    <p class="text-gray-500 font-bold mb-2">以下の家族ルームへ招待されています</p>

    <!--------- 招待されているルームの名前 ---------->
    <h1 class="join-room-name">
      <%= @room.name %>
    </h1>

    <p class="invitation-desc">
      このルームに入室して、<br>
      家族と共に詐欺対策の稽古を始めますか？
    </p>

      <!---------- アラートの表示 ---------->
      <% if @show_switch_warning %>
        <div class="room-alert-wrapper">
          <div role="alert" class="room-alert-box layout-stack">
            <div class="flex items-start gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 alert-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>

              <!---------- アラートの説明文 ---------->
              <div class="alert-content no-wrap">
                <span class="alert-title">本当に入室しますか？</span>
                <span class="alert-desc">現在所属している家族ルームから抜けることになります。<br>再び参加するには、招待リンクが必要になります。</span>
              </div>
            </div>

            <!------- 「いいえ」ボタン ------->
            <div class="alert-actions">
              <%= link_to "いいえ",
                    home_path,
                    class: "btn btn-sm btn-ghost bg-white hover:bg-gray-100 border-gray-300" %>

              <!----------- 「はい」ボタン ---------->
              <%= button_to "はい",
                    room_invitation_path(@room, @invitation, token: params[:token], confirm: 1),
                    method: :patch,
                    class: "btn btn-sm btn-error text-white" %>
            </div>
          </div>
        </div>
      <% end %>

    <!---------- ルームに属していない場合(アラートなし) ---------->
    <% unless @show_switch_warning %>
      <div class="my-8">
        <%= button_to room_invitation_path(@room, @invitation, token: params[:token]),
              method: :patch,
              class: "btn-primary-action w-full" do %>
          入室する（参加）
        <% end %>
      </div>
    <% end %>

  </div>
</div>