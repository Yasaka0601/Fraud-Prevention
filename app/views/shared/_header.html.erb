<header class="site-header">
  <div class="header-inner">
    <%= link_to (user_signed_in? ? home_path : root_path), class: "header-logo-link" do %>
      <%= image_tag "header_logo.png", alt: "詐欺対策道場", class: "header-logo" %>
    <% end %>

    <nav class="header-nav">
      <% if user_signed_in? %>
        <%= link_to edit_user_registration_path, class: "user-link" do %>
          <%= avatar_image_tag(current_user) %>
          <span class="header-user-name"><%= current_user.name %></span>
        <% end %>
      <% else %>
        <%= link_to "新規登録", new_user_registration_path, class: "header-link" %>
      <% end %>
    </nav>
  </div>
</header>