<%# AdSense の広告ユニット（本番だけで表示） %>
<% if Rails.env.production? %>
  <div class="ad-unit">
    <p class="ad-unit__label">スポンサーリンク</p>
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="ca-pub-9318861429187964"
         data-ad-slot="<%= slot %>"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
<% end %>
