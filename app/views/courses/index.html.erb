<div class="courses-container animate-fade-in">

  <%# タイトルエリア %>
  <div class="courses-header">
    <h1 class="courses-title">
      <%# カテゴリー名があれば表示、なければ固定タイトル %>
      <%= "#{@category.name}の段" %>
    </h1>
    <p class="courses-subtitle">挑戦する稽古を選んでください</p>
  </div>

  <%# コースリスト %>
  <% if @courses.present? %>
    <div class="course-list">
      <% @courses.each do |course| %>
        <%# カード全体をリンクにする %>
        <%= link_to course_quiz_path(course, 1, quiz_start: true), class: "course-card group" do %>

          <div class="course-info">
            <%# --- バッジ表示エリア（レイアウト崩れを防ぐためコース名の上に配置） --- %>
            <% if @conquered_course_ids.include?(course.id) || @challenged_course_ids.include?(course.id) %>
              <div class="course-badge-area">
                <% if @conquered_course_ids.include?(course.id) %>
                  <span class="course-badge badge-conquered">全問制覇</span>
                <% elsif @challenged_course_ids.include?(course.id) %>
                  <span class="course-badge badge-challenged">稽古済</span>
                <% end %>
              </div>
            <% end %>

            <h2 class="course-name">
              <%= course.name %>
            </h2>
          </div>

          <div class="course-start-btn">
            <span>稽古開始</span>
            <%# 矢印アイコン %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 12h18" />
            </svg>
          </div>

        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# データがない場合の表示 %>
    <div class="text-center py-10 border-2 border-dashed border-gray-300 rounded-lg">
      <p class="text-gray-500 font-serif-jp">ただいま準備中でございます。</p>
    </div>
  <% end %>

  <%# 戻るボタン %>
  <div class="courses-footer">
    <%= link_to home_path, class: "back-link" do %>
      <span>&larr; 戻る</span>
    <% end %>
  </div>

</div>