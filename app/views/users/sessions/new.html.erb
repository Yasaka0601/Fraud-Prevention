<% content_for(:title, t('.title')) %>

<div class="form-page bg-washi-pattern">
  <div class="reg-bg">
    <div class="reg-bg__blob reg-bg__blob--navy"></div>
    <div class="reg-bg__blob reg-bg__blob--red"></div>
  </div>

  <div class="form-card">
    <div class="reg-head">
      <h2 class="reg-head__title"><%= t('.title') %></h2>
      <p class="reg-head__sub">稽古を再開するためログイン手続きを行います</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%# Deviseのエラー表示が必要ならここに（今は新規登録側だけなので省略でもOK） %>

      <div class="form-field">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: " form-input" %>
      </div>

      <div class="form-field form-field--last">
        <%= f.label :password, t('.password'), class: "form-label" %>
        <%= f.password_field :password,
              autocomplete: "current-password",
              class: "form-input" %>
      </div>

      <%# ログイン状態を保持 %>
      <% if devise_mapping.rememberable? %>
        <%= f.hidden_field :remember_me, value: 1 %>
      <% end %>

      <div class="form-actions">
        <%= f.submit t('.submit'), class: "form-submit" %>
      </div>
    <% end %>

    <div class="form-divider">
      <div class="form-divider__line"></div>
      <span class="form-divider__text">または</span>
      <div class="form-divider__line"></div>
    </div>

    <%= render "shared/line_button" %>

    <div class="reg-links">
      <%= link_to "アカウントをお持ちでない方はこちら（新規登録）",
                  new_user_registration_path,
                  class: "reg-link" %>
    </div>

    <div class="reg-links" style="margin-top: 8px;">
      <%= link_to "パスワードを忘れた方はこちら", new_user_password_path, class: "reg-link" %>
    </div>
  </div>

  <div class="form-shadow"></div>
</div>