<% content_for(:title, t('.title')) %>

<div class="reg-page bg-washi-pattern">
  <div class="reg-bg">
    <div class="reg-bg__blob reg-bg__blob--navy"></div>
    <div class="reg-bg__blob reg-bg__blob--red"></div>
  </div>

  <div class="reg-card">
    <div class="reg-head">
      <h2 class="reg-head__title"><%= t('.title') %></h2>
      <p class="reg-head__sub">道場への入門手続きを行います</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="reg-errors">
        <%= render "users/shared/error_messages", resource: resource %>
      </div>

      <div class="reg-field">
        <%= f.label :name, class: "reg-label" %>
        <%= f.text_field :name,
              autofocus: true,
              autocomplete: "name",
              class: "input-dojo reg-input reg-input--text" %>
      </div>

      <div class="reg-field">
        <%= f.label :email, class: "reg-label" %>
        <%= f.email_field :email,
              autocomplete: "email",
              class: "input-dojo reg-input reg-input--text" %>
      </div>

      <div class="reg-field">
        <div class="reg-field__row">
          <%= f.label :password, t('.password'), class: "reg-label reg-label--tight" %>
          <% if @minimum_password_length %>
            <span class="reg-note">※<%= @minimum_password_length %>文字以上</span>
          <% end %>
        </div>
        <%= f.password_field :password,
              autocomplete: "new-password",
              class: "input-dojo reg-input" %>
      </div>

      <div class="reg-field reg-field--last">
        <%= f.label :password_confirmation, class: "reg-label" %>
        <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "input-dojo reg-input" %>
      </div>

      <div class="reg-actions">
        <%= f.submit t('.submit'), class: "reg-submit" %>
      </div>
    <% end %>

    <div class="reg-divider">
      <div class="reg-divider__line"></div>
      <span class="reg-divider__text">または</span>
      <div class="reg-divider__line"></div>
    </div>

    <%= render "shared/line_button" %>

    <div class="reg-links">
      <%= link_to "すでにアカウントをお持ちの方はこちら",
                new_user_session_path,
                class: "reg-link" %>
    </div>
  </div>

  <div class="reg-shadow"></div>
</div>