<div class="profile-container animate-fade-in">

  <div class="profile-card">
    <h1 class="profile-title">門下生情報の変更</h1>

    <%= form_for(resource,
                  as: resource_name,
                  url: registration_path(resource_name),
                  html: {
                    method: :put,
                    data: { controller: "profile-image badge-select" }
                  }
                ) do |f| %>

      <!------ エラーメッセージ ------>
      <div class="mb-6">
        <%= render "devise/shared/error_messages", resource: resource %>
      </div>

      <!------ アイコンプレビュー ------>
      <div class="profile-avatar-section">
        <div class="avatar-wrapper">
          <% if current_user.image.attached? %>
            <%= image_tag current_user.image,
                class: "profile-avatar-preview",
                alt: current_user.name,
                data: { profile_image_target: "preview" } %>
          <% else %>
            <%= image_tag "icon.png",
                class: "profile-avatar-preview",
                alt: "デフォルトアイコン",
                data: { profile_image_target: "preview" } %>
          <% end %>
          <span class="avatar-badge"
                data-badge-select-target="avatarBadge"
                <%= current_user.selected_badge_type.blank? ? "hidden" : "" %>>
            <%= badge_icon(current_user.selected_badge_type) if current_user.selected_badge_type.present? %>
          </span>
        </div>
      </div>

      <!----- 名前入力 ----->
      <div class="profile-field">
        <%= f.label :name, "名前", class: "profile-label" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "profile-input" %>
      </div>

      <!----- メールアドレス ----->
      <div class="profile-field">
        <%= f.label :email, "メールアドレス", class: "profile-label" %>
        <%= f.email_field :email, autocomplete: "email", class: "profile-input" %>
      </div>

      <!----- パスワード変更 ----->
      <div class="profile-field">
        <%= f.label :password, "パスワード（変更する場合のみ入力）", class: "profile-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "profile-input" %>
      </div>

      <div class="profile-field">
        <%= f.label :password_confirmation, "パスワード確認", class: "profile-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "profile-input" %>
      </div>

      <!----- 現在のパスワード（必須） ----->
      <div class="profile-field">
        <%= f.label :current_password, "現在のパスワード（変更を保存するために必要）", class: "profile-label" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "profile-input" %>
      </div>

      <!----- アイコン画像選択 ----->
      <div class="profile-field">
        <fieldset class="fieldset">
          <legend class="profile-label">アイコン</legend>

          <%= f.file_field :image,
            accept: User::ACCEPTED_CONTENT_TYPES.join(","),
            class: "file-input file-input-primary file-input-sm text-sm w-full max-w-none !bg-white !text-black",
            id: "profile_image",
            data: {
              profile_image_target: "fileInput",
              action: "change->profile-image#preview"
            } %>

          <span class="profile-hint">
            最大 5MB / JPEG・PNG・GIF・WebP
          </span>
        </fieldset>

        <div class="hidden mt-3 flex items-center gap-2" data-profile-image-target="loading" aria-live="polite">
          <span class="loading loading-spinner loading-sm"></span>
          <span class="text-sm">画像を読み込み中...</span>
        </div>
      </div>

      <!----- 表示バッジ選択 ----->
      <div class="profile-field">
        <fieldset class="fieldset">
          <legend class="profile-label">表示する勲章</legend>

          <% if @badges.present? %>
            <button type="button" class="btn-badge-select" onclick="badge_modal.showModal()">
              <div class="badge-select-content" data-badge-select-target="buttonContent">
                <% if current_user.selected_badge_type.present? %>
                  <div class="badge-select-icon">
                    <%= badge_icon(current_user.selected_badge_type) %>
                  </div>
                  <span class="badge-select-name"><%= UserBadge::BADGE_NAMES[current_user.selected_badge_type.to_sym] %></span>
                <% else %>
                  <span class="badge-select-name text-gray-400">表示しない</span>
                <% end %>
              </div>
              <div class="badge-select-action">
                <i class="fas fa-pencil-alt"></i>
                <span>変更</span>
              </div>
            </button>

            <!----- DaisyUI モーダル ----->
            <dialog id="badge_modal" class="modal" onclick="if(event.target===this)this.close()">
              <div class="modal-box badge-modal-box bg-white">
                <h3 class="font-bold text-lg mb-4 text-[#1F2F54] border-b border-gray-200 pb-2">表示する勲章を選択</h3>

                <div class="badge-radio-list">
                  <!----- 表示しない ----->
                  <label class="badge-radio-item badge-radio-item--none"
                         data-badge-select-target="radioLabel"
                         data-badge-type=""
                         data-badge-name="表示しない">
                    <%= f.radio_button :selected_badge_type, "", checked: current_user.selected_badge_type.blank?, class: "hidden" %>
                    <div class="badge-radio-content">
                      <i class="fas fa-ban text-gray-400 text-xl"></i>
                      <span class="badge-radio-name">表示しない</span>
                    </div>
                  </label>

                  <!----- 獲得済みバッジ一覧 ----->
                  <% @badges.each do |badge| %>
                    <label class="badge-radio-item"
                           data-badge-select-target="radioLabel"
                           data-badge-type="<%= badge.badge_type %>"
                           data-badge-name="<%= UserBadge::BADGE_NAMES[badge.badge_type.to_sym] %>">
                      <%= f.radio_button :selected_badge_type, badge.badge_type,
                          checked: current_user.selected_badge_type == badge.badge_type, class: "hidden" %>
                      <div class="badge-radio-content">
                        <div class="badge-radio-icon">
                          <%= badge_icon(badge.badge_type) %>
                        </div>
                        <span class="badge-radio-name"><%= UserBadge::BADGE_NAMES[badge.badge_type.to_sym] %></span>
                      </div>
                    </label>
                  <% end %>
                </div>

                <!----- キャンセルと選択ボタンを配置 ----->
                <div class="modal-action flex justify-end gap-3 mt-4">
                  <button type="button" class="btn btn-ghost text-gray-600" data-action="badge-select#cancel">キャンセル</button>
                  <button type="button" class="btn bg-[#C63D2F] hover:bg-[#a03024] text-white border-none" data-action="badge-select#apply">選択</button>
                </div>
              </div>
            </dialog>
          <% else %>
            <div class="badge-empty-preview">
              まだ勲章を獲得していません。
            </div>
          <% end %>
        </fieldset>
      </div>

      <!----- 更新ボタン ----->
      <div class="profile-actions">
        <%= f.submit "変更を保存する", class: "btn-profile-update" %>
      </div>
    <% end %>

    <!----- 戻るボタン ----->
    <div class="profile-footer">
      <%= link_to user_path(current_user.public_id), class: "btn-back-to-categories" do %>
        マイページへ戻る
      <% end %>
    </div>
  </div>
</div>