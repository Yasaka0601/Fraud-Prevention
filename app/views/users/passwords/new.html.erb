<% content_for(:title, "パスワードの再設定") %>

<div class="form-page bg-washi-pattern">
  <div class="form-card">
    <div class="reg-head">
      <h2 class="reg-head__title">パスワードの再設定</h2>
      <p class="reg-head__sub">登録しているメールアドレスを入力してください</p>
    </div>

    <%= form_for(resource,
          as: resource_name,
          url: password_path(resource_name),
          html: { method: :post }) do |f| %>

      <div class="form-errors">
        <%= render "users/shared/error_messages", resource: resource %>
      </div>

      <div class="form-field form-field--last">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= f.submit "再設定メール送信", class: "form-submit" %>
      </div>
    <% end %>

    <div class="form-divider">
      <div class="form-divider__line"></div>
      <span class="form-divider__text">または</span>
      <div class="form-divider__line"></div>
    </div>

    <div class="reg-links">
      <%= link_to "アカウントをお持ちでない方はこちら（新規登録）",
                  new_user_registration_path,
                  class: "reg-link" %>
    </div>

    <div class="reg-links">
      <%= link_to "ログインはこちら",
                  new_user_session_path,
                  class: "reg-link" %>
    </div>
  </div>

  <div class="form-shadow"></div>
</div>